# Gmail for outbound notifications (use a Gmail App Password, not your normal password)
SENDER_EMAIL=
SENDER_PASSWORD=
RECIPIENT_EMAIL=

# ClassPass auth token + user ID, captured from DevTools after signing in to classpass.com.
# The token is long-lived (weeks to months). Rotate it when the bot emails you that auth
# is stale. There is no auto-refresh (login endpoint is hidden behind a service worker).
#
# 1. Sign in at classpass.com
# 2. Open DevTools, Network tab, trigger any classpass action (e.g. browse a venue)
# 3. Find any request to classpass.com/_api/...
# 4. Copy the value after "Token " from the `cp-authorization` request header
# 5. User ID appears in the URL path of /_api/v1/users/<USER_ID>/reservations
CLASSPASS_AUTH_TOKEN=
CLASSPASS_USER_ID=

# Optional Google Calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_EVENT_COLOR=peacock
